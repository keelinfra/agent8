# Controller for the integration test: no security, Pipeline plugins only.
ARG JENKINS_TAG=lts-jdk21
FROM jenkins/jenkins:${JENKINS_TAG}
ENV JAVA_OPTS=-Djenkins.install.runSetupWizard=false
# Inbound agent port: any free one, since the runner may already use 50000 (the agent finds it over HTTP).
ENV JENKINS_SLAVE_AGENT_PORT=0
# Plugin versions that support this Jenkins: the version-specific update center first, so
# older Jenkins lines (e.g. 2.462.3) can be tested too.
RUN for uc in https://updates.jenkins.io/dynamic-stable-$JENKINS_VERSION https://updates.jenkins.io/dynamic-$JENKINS_VERSION https://updates.jenkins.io; do \
      JENKINS_UC=$uc jenkins-plugin-cli --plugins \
        workflow-job workflow-cps workflow-durable-task-step workflow-basic-steps pipeline-stage-step junit && exit 0; \
    done; exit 1
